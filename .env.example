# Copy to .env for local development. Never commit the real .env.

DATABASE_URL=jdbc:postgresql://localhost:5432/fxdesk
DATABASE_USERNAME=fxdesk
DATABASE_PASSWORD=fxdesk

# At least 32 characters: openssl rand -base64 48
JWT_SECRET=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Set to false on anything that is not a demo deployment
SEED_DEMO_DATA=true
